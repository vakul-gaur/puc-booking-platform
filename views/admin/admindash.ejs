<%- layout("/layouts/boilerplate") %>

<body>

    <a href="/admin/checkers" class="mt-5 mb-5">
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Manage Checkers</h5>
                    </div>
                </div>
            </div>
        </div>
    </a>

    <div class="container mt-5 mb-5">
        <h1 class="mb-4">Welcome, <%= adminName %>!</h1>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Total Users</h5>
                        <p class="card-text"><%= totalUsers %></p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-white bg-secondary mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Total Bookings</h5>
                        <p class="card-text"><%= totalBookings %></p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="card text-white bg-danger mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Pending Bookings</h5>
                        <p class="card-text"><%= pendingBookings %></p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-white bg-info mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Completed Bookings</h5>
                        <p class="card-text"><%= completedBookings %></p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-white bg-success mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Total Revenue</h5>
                        <p class="card-text">₹ <%= totalRevenue %></p>
                    </div>
                </div>
            </div>
        </div>

        <h3>Recent Bookings</h3>

        <% if (!recentBookings || recentBookings.length === 0) { %>
            <p class="text-muted">No bookings found.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Vehicles</th>
                                <th>Booking Date</th>
                                <th>Payment Type</th>
                                <th>Payment Status</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentBookings.forEach(b => { %>
                                <tr>
                                    <td> <%= b.user ? b.user.username : "User Deleted" %> </td>
                                    <td> <% b.vehicles.forEach(v => { %>
                                        <div><%= v.number %> (<%= v.type %>W)</div>
                                        <% }); %>
                                    </td>
                                    <td><%= b.createdAt.toDateString() %></td>
                                    <td><%= b.paymentType %></td>
                                    <td><%= b.paymentStatus %></td>
                                    <td><%= b.status %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
        <% } %>
    </div>

</body>