<%- layout("/layouts/boilerplate") %>

<body>
<div class="container py-4">

<!-- Header Section -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row align-items-center">

                <div class="col-md-8">
                    <h2 class="fw-bold mb-1">
                        <i class="fas fa-user-shield text-primary me-2"></i>
                        Welcome, <%= checker.username %>
                    </h2>

                    <p class="text-muted mb-0">
                        <i class="fas fa-phone me-2"></i>
                        <%= checker.contact %>
                    </p>

                    <p class="text-muted mb-0">
                        <i class="fas fa-id-card me-2"></i>
                        License: <%= checker.licenseNumber %>
                    </p>
                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                    <% if(checker.authorizationStatus === "approved"){ %>
                        <span class="badge bg-success p-2">Approved</span>
                    <% } %>

                    <% if(checker.authorizationStatus === "pending"){ %>
                        <span class="badge bg-warning text-dark p-2">Pending</span>
                    <% } %>

                    <% if(checker.authorizationStatus === "rejected"){ %>
                        <span class="badge bg-danger p-2">Rejected</span>
                    <% } %>

                </div>

            </div>
        </div>
    </div>


<!-- Earnings -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Today Income</h6>
                    <h3 class="fw-bold text-success">₹ <%= earnings.today || 0 %></h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Last 24 Hours</h6>
                    <h3 class="fw-bold text-primary">₹ <%= earnings.last24Hours || 0 %></h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Monthly Income</h6>
                    <h3 class="fw-bold text-warning">₹ <%= earnings.monthly || 0 %></h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Completed Jobs</h6>
                    <h3 class="fw-bold text-dark"><%= earnings.completedJobs || 0 %></h3>
                </div>
            </div>
        </div>

    </div>


<!-- Bookings -->
    <% if(activeBooking){ %>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-success text-white fw-bold">
            <i class="fas fa-tools me-2"></i>
            Active Booking
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Booking ID:</strong> #<%= activeBooking.id %>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Vehicle Number:</strong>
                    <%= activeBooking.vehicleNumber %>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Vehicle Model:</strong>
                    <%= activeBooking.vehicleModel %>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Price:</strong>
                    ₹ <%= activeBooking.price %>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Customer Phone:</strong>
                    <%= activeBooking.userPhone %>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Location:</strong>
                    <%= activeBooking.address %>
                </div>

            </div>

            <hr>

            <form action="/complete_booking" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="booking_id" value="<%= activeBooking.id %>">

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Upload Proof Photo
                    </label>

                    <input type="file" name="proofPhoto" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Payment Status
                    </label>

                    <select name="payment_status" class="form-select" required>
                        <option value="">Select</option>
                        <option value="paid">Paid</option>
                        <option value="pending">Pending</option>
                    </select>
                </div>

                <div class="d-flex gap-2 flex-wrap">

                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check-circle me-2"></i>
                        Complete Booking
                    </button>

                    <a href="tel:<%= activeBooking.userPhone %>" class="btn btn-outline-dark">
                        <i class="fas fa-phone me-2"></i>
                        Call
                    </a>

                    <a 
                    href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(activeBooking.address) %>"
                    target="_blank"
                    class="btn btn-outline-primary">
                        <i class="fas fa-map-marker-alt me-2"></i>
                        Directions
                    </a>
                </div>
            </form>
        </div>
    </div>
    <% } %>


    <!-- Pending Bookings -->
    <div class="card border-0 shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold">
                <i class="fas fa-list me-2"></i>
                Nearby Pending Bookings
            </span>

            <button onclick="location.reload() "class="btn btn-sm btn-primary"> Refresh </button>
        </div>

        <div class="card-body">

            <% if(activeBooking){ %>

                <div class="text-center py-5">
                    <h5 class="text-muted"> Complete current booking first </h5>
                </div>

            <% } else if(pendingBookings.length > 0){ %>

                <div class="table-responsive">

                    <table class="table table-hover">

                        <thead>
                        <tr>
                            <th>ID</th>
                            <th>Vehicle</th>
                            <th>Date</th>
                            <th>Price</th>
                            <th>Location</th>
                            <th>Action</th>
                        </tr>
                        </thead>

                        <tbody>

                        <% pendingBookings.forEach(booking=>{ %>

                        <tr>

                            <td>#<%= booking.id %></td>

                            <td>
                                <%= booking.vehicleNumber %>
                                <br>
                                <small class="text-muted">
                                    <%= booking.vehicleModel %>
                                </small>
                            </td>

                            <td>
                                <%= booking.createdAtFormatted %>
                            </td>

                            <td>
                                ₹ <%= booking.price %>
                            </td>

                            <td>
                                <%= booking.address %>
                            </td>

                            <td>

                                <form 
                                action="/accept_booking" 
                                method="POST">

                                    <input 
                                    type="hidden" 
                                    name="booking_id" 
                                    value="<%= booking.id %>">

                                    <button 
                                    type="submit"
                                    class="btn btn-success btn-sm">

                                        Accept

                                    </button>

                                </form>

                            </td>

                        </tr>

                        <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } else { %>

                <div class="text-center py-5">

                    <i class="fas fa-clipboard-check fa-3x text-muted mb-3"></i>

                    <h5 class="text-muted">
                        No Pending Bookings
                    </h5>

                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
setInterval(()=>{
    location.reload();
},10000);
</script>

</body>