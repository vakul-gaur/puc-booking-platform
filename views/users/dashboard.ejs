<%- layout("/layouts/boilerplate") %>

<body>
<div class="dashboard-container">

    <div class="welcome mb-4">
        <h2>
            <i class="fas fa-user-circle me-2"></i>
            Welcome, <%= currUser.username %>!
        </h2>
    </div>

       <div class="card mt-5">
        <div class="card-header bg-success text-white">
            <i class="fas fa-history me-2"></i> Your Bookings
        </div>

        <div class="card-body p-0">
            <% if (!bookings || bookings.length === 0) { %>
                <p class="p-4 text-center text-muted">No bookings found.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Vehicles</th>
                                <th>Booking Date</th>
                                <th>Total Price</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th>Location</th>
                            </tr>
                        </thead>
                        <tbody>
                        <% bookings.forEach(booking => { %>
                            <tr>
                                <td>
                                    <% booking.vehicles.forEach((v, i) => { %>
                                        <%= v.number %> (<%= v.type %>-W, <%= v.fuel %>)<%= i < booking.vehicles.length -1 ? ", " : "" %>
                                    <% }) %>
                                </td>
                                <td>
                                    <%= booking.createdAt.toLocaleDateString("en-IN", { day:"2-digit", month:"short", year:"numeric" }) %>
                                </td>
                                <td>₹<%= booking.totalPrice.toFixed(2) %></td>
                                <td>
                                    <span class="badge <%= booking.status === "Completed" ? "bg-dark" : "bg-secondary" %>">
                                        <%= booking.status %>
                                    </span>
                                </td>
                                <td>
                                    <span class="badge <%= booking.paymentStatus === "Paid" ? "bg-success" : "bg-warning" %>">
                                        <%= booking.paymentStatus %>
                                    </span>
                                </td>
                                <td><%= booking.address %></td>
                            </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>


    <!-- Booking Card -->
    <div class="card">
        <div class="card-header">
            <i class="fas fa-calendar-plus me-2"></i> Book PUC Check
        </div>

        <div class="card-body">
            <form method="POST" action="/booking" id="bookingForm" class="row g-3">

                <!-- Vehicle Details -->
                <h4>Vehicle Details</h4>

                <div id="vehicles-container">
                    <div class="row g-3 vehicle-row align-items-end" data-index="0">

                        <div class="col-md-4">
                            <label class="form-label">Vehicle Number</label>
                            <input type="text" class="form-control"
                                   name="vehicles[0][number]"
                                   required style="text-transform: uppercase;">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Vehicle Type</label>
                            <select class="form-select vehicle-type"
                                    name="vehicles[0][type]" required>
                                <option value="2">2-Wheeler</option>
                                <option value="3">3-Wheeler</option>
                                <option value="4">4-Wheeler</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Fuel Type</label>
                            <select class="form-select"
                                    name="vehicles[0][fuel]" required>
                                <option value="Petrol">Petrol</option>
                                <option value="Diesel">Diesel</option>
                                <option value="CNG">CNG</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button type="button"
                                    class="btn btn-outline-danger remove-vehicle d-none">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>

                    </div>
                </div>

                <div class="mt-3">
                    <button type="button" class="btn btn-outline-primary" id="addVehicleBtn">
                        <i class="fas fa-plus"></i> Add Another Vehicle
                    </button>
                </div>

                <div class="mt-3">
                    <h5>Total Price: ₹<span id="totalPrice">0</span></h5>
                    <input type="hidden" name="total_price" id="total_price">
                </div>

                <!-- Owner Details -->
                <h4 class="mt-4">Owner Details</h4>

                <div class="col-md-4">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control"
                           value="<%= currUser.username %>" readonly>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Mobile Number</label>
                    <input type="text" class="form-control"
                           value="<%= currUser.contact %>" readonly>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Payment Method</label>
                    <select class="form-select" name="payment_type" required>
                        <option value="" disabled selected>Select Payment Method</option>
                        <option value="UPI">UPI</option>
                        <option value="COD">Cash on Delivery</option>
                    </select>
                </div>

                <!-- Booking Details -->
                <h4 class="mt-4">Booking Details</h4>

                <div class="col-md-12">
                    <label class="form-label">Address</label>
                    <input type="text" class="form-control"
                           name="address" id="address" required>
                </div>

                <div class="col-md-12 mt-2">
                    <button type="button" class="btn btn-outline-primary" id="useLocationBtn">
                        <i class="fas fa-location-arrow me-1"></i> Use Current Location
                    </button>
                </div>

                <div class="col-md-12 mt-2">
                    <div id="locationPreview"
                        class="alert alert-info d-none">
                        <i class="fas fa-map-marker-alt me-1"></i>
                        <strong>Detected location:</strong>
                        <span id="locationText"></span>
                    </div>
                </div>

                <input type="hidden" name="latitude" id="latitude">
                <input type="hidden" name="longitude" id="longitude">

                <div class="col-md-12 text-center mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check me-2"></i> Book Now
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

</body>
